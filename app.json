{
  "expo": {
    "name": "Celebra",
    "slug": "celebra",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#080E21",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.celebra.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "feather",
                "fontDefinitions": [
                  {
                    "path": "./node_modules/@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/Feather.ttf",
                    "weight": 400
                  }
                ]
              },
              {
                "fontFamily": "material-community",
                "fontDefinitions": [
                  {
                    "path": "./node_modules/@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/MaterialCommunityIcons.ttf",
                    "weight": 400
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./node_modules/@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/Feather.ttf",
              "./node_modules/@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/MaterialCommunityIcons.ttf"
            ]
          }
        }
      ],
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "1a448861-4c80-4505-8160-59d3bb8bd0a7"
      }
    },
    "owner": "thalysson98"
  }
}
